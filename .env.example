# Copia este archivo como .env (nunca lo subas a GitHub) o pon estas variables en Render.
PORT=3000
# real = 1 ciclo cada 10 min con la hora y el clima reales · fast = demo acelerada
SIM_MODE=real
GAME_TZ=Europe/Madrid
WEATHER_LAT=40.4168
WEATHER_LON=-3.7038
DATA_DIR=/var/data

# IA con Claude (opcional). Sin clave, cada colonia usa su autopiloto con personalidad.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# Dinero real máximo para las IA al empezar, en dólares
AI_BUDGET_USD=5
# Parte de los ingresos reales registrados que se destina a pagar a las IA
AI_REVENUE_SHARE=0.3
# Ciclos mínimos entre consultas de una misma colonia (144 = una vez al día en modo real)
AI_MIN_TICKS=144

# Anti-abuso. Proxies de confianza delante del servidor (Render suele ser 1; compruébalo con /api/admin/whoami).
# Con 0 se ignora X-Forwarded-For, que cualquiera puede inventar.
TRUSTED_PROXY_HOPS=0
# Cuentas nuevas por hora en todo el servidor (además de 5 por hora y por IP)
JOIN_PER_HOUR=60

# Panel del dueño: /api/admin/metrics y /api/admin/revenue
ADMIN_TOKEN=cambia-esto-por-algo-largo-y-secreto
# 1 = botón de compra de prueba (sin cobro real). Ponlo a 0 en producción.
DEMO_PURCHASES=0
# Clave de las copias firmadas de las cuentas. Si está vacía se usa ADMIN_TOKEN; sin ninguna de las dos no hay copias.
SAVE_SECRET=
# Semilla del mapa de Oruz. Si está vacía sale de la clave anterior, así el mapa no cambia si el mundo se crea de nuevo.
ORUZ_SEED=

# Titular y contacto que aparecen en /terminos y /privacidad
LEGAL_TITULAR=
LEGAL_CONTACTO=
